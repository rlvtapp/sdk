{
  "$schema": "https://raw.githubusercontent.com/rlvtapp/poolster/main/schemas/v1/poolster.schema.json",
  "openapi": {
    "input": "./specs/openapi.json",
    "name": "Relevate",
    "version": "0.1.0"
  },
  "output": {
    "path": "./packages"
  },
  "defaults": {
    "client_style": "namespaced"
  },
  "packages": [
    {
      "language": "typescript",
      "path": "typescript",
      "name": "@relevate/sdk",
      "plugins": [
        {
          "name": "sdk",
          "transport": "fetch",
          "client_name": "Relevate"
        },
        {
          "name": "tanstack-react-query",
          "output": "react-query",
          "group_by_tag": true
        },
        {
          "name": "tanstack-vue-query",
          "output": "vue-query",
          "group_by_tag": true
        },
        {
          "name": "faker",
          "output": "fixtures"
        },
        {
          "name": "msw",
          "output": "mocks"
        },
        {
          "name": "cypress",
          "output": "cypress"
        }
      ],
      "release": {
        "schema_version": 1,
        "language": "typescript",
        "name": "@relevate/sdk",
        "version": "0.1.0",
        "build": [
          {
            "program": "npm",
            "args": [
              "run",
              "build"
            ]
          }
        ],
        "test": [
          {
            "program": "node",
            "args": [
              "../../scripts/check-typescript.mjs"
            ]
          }
        ],
        "publisher": {
          "registry": "npm",
          "release_type": "node",
          "commands": [],
          "extra_files": []
        }
      }
    },
    {
      "language": "python",
      "path": "python",
      "name": "relevate-sdk",
      "plugins": [
        {
          "name": "sdk"
        }
      ]
    },
    {
      "language": "go",
      "path": "go",
      "name": "github.com/rlvtapp/sdk/packages/go",
      "plugins": [
        {
          "name": "sdk"
        }
      ]
    },
    {
      "language": "rust",
      "path": "rust",
      "name": "relevate-sdk",
      "plugins": [
        {
          "name": "sdk"
        }
      ]
    },
    {
      "language": "java",
      "path": "java",
      "name": "app.relevate.sdk",
      "plugins": [
        {
          "name": "sdk"
        }
      ]
    },
    {
      "language": "csharp",
      "path": "dotnet",
      "name": "Relevate.Sdk",
      "plugins": [
        {
          "name": "sdk"
        }
      ]
    },
    {
      "language": "php",
      "path": "php",
      "name": "relevate/sdk",
      "plugins": [
        {
          "name": "sdk"
        }
      ]
    },
    {
      "language": "elixir",
      "path": "elixir",
      "name": "relevate_sdk",
      "plugins": [
        {
          "name": "sdk"
        }
      ]
    },
    {
      "language": "ruby",
      "path": "ruby",
      "name": "relevate_sdk",
      "plugins": [
        {
          "name": "sdk"
        }
      ]
    },
    {
      "language": "mock",
      "path": "mock-server",
      "plugins": [
        {
          "name": "server",
          "port": 4010
        }
      ]
    }
  ]
}
